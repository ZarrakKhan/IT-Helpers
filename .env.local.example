# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real secrets.

# Required: Resend API key, used server-side by src/app/api/contact/route.ts
# to send the contact form submission. https://resend.com/api-keys
RESEND_API_KEY=your_api_key_here

# Optional: sending address once a domain is verified in Resend. Falls back
# to Resend's shared testing address (onboarding@resend.dev) if unset.
RESEND_FROM_EMAIL=

# Optional: Google Site Verification / Search Console
GOOGLE_SITE_VERIFICATION=
