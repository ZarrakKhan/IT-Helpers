# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real secrets.

# Contact form submission endpoint (client-side, used by ContactSection.tsx).
# Formspree: https://formspree.io/f/your-form-id
# Or a Resend-backed API route: https://<your-domain>/api/contact
NEXT_PUBLIC_FORM_ENDPOINT=

# Optional: Resend API key, if routing the form through a server-side
# Next.js API route instead of a third-party form handler directly.
RESEND_API_KEY=

# Optional: Google Site Verification / Search Console
GOOGLE_SITE_VERIFICATION=
